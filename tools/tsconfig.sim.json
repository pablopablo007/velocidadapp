{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": [
        "../src/*"
      ]
    },
    "rootDir": "../src",
    "outDir": "../.sim-build"
  },
  "include": [
    "../src/services/tripEngine.ts",
    "../src/services/speedStats.ts",
    "../src/services/longitudinal.ts",
    "../src/utils/geo.ts",
    "../src/utils/format.ts",
    "../src/utils/altitude.ts",
    "../src/utils/gauge.ts",
    "../src/vehicles/polo.ts",
    "../src/theme/theme.ts"
  ]
}
